  );
}

// ANALYZE TAB
function AnalyzeTab({ prefillText = "", onClearPrefill }) {
  const [text, setText] = useState(prefillText);
  useEffect(() => {
    if (prefillText) {
      setText(prefillText);
      if (onClearPrefill) onClearPrefill();
    }
  }, [prefillText]);
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState(null);
  const [error, setError] = useState("");

  const analyze = async () => {
    if (!text.trim()) return;
    setLoading(true);
    setResult(null);
    setError("");
    try {
      const res = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          model: "claude-sonnet-4-20250514",
          max_tokens: 1000,
          messages: [{
            role: "user",
            content: `You are a government contracting expert. Analyze this solicitation text and return ONLY a JSON object with these fields:
{
  "title": "contract title or best guess",
  "agency": "agency name",
  "scope": "2-3 sentence summary of what they need",
  "deadline": "submission deadline if mentioned",
  "value": "estimated contract value if mentioned",
  "setAside": "set-aside type if mentioned (WOSB, 8a, SDB, etc) or Open",
  "naics": "NAICS code if mentioned",
  "requirements": ["up to 5 key requirements as short bullet points"],
  "evaluation": ["up to 4 evaluation criteria as short bullet points"],
  "redFlags": ["any concerns or disqualifiers for a small subcontracting business"],
  "recommendation": "BID or NO BID",
  "recommendationReason": "1-2 sentences explaining the recommendation",
  "fitScore": number between 0-100
}

Solicitation text:
${text}`
          }]
        })
      });
      const data = await res.json();
      const raw = data.content?.[0]?.text || "";
      const clean = raw.replace(/```json|```/g, "").trim();
      setResult(JSON.parse(clean));
    } catch (e) {
      setError("Analysis failed. Paste a longer solicitation excerpt and try again.");
    }
    setLoading(false);
  };

  return (
    <div>
      <div style={{ marginBottom: 24 }}>
        <div style={{ fontFamily: font.display, fontSize: 32, letterSpacing: 2, marginBottom: 4 }}>AI SOLICITATION ANALYSIS</div>
        <div style={{ fontSize: 13, color: C.textMid }}>Paste any RFP or solicitation text — get a full breakdown in seconds</div>
      </div>

      <Card style={{ marginBottom: 16 }}>
        <textarea
          value={text}
          onChange={e => setText(e.target.value)}
          placeholder="Paste solicitation text, RFP excerpt, or opportunity description here..."
          style={{
            width: "100%", minHeight: 180, background: "#0a0a0a",
            border: `1px solid ${C.border}`, borderRadius: 8, padding: 14,
            color: C.text, fontFamily: font.mono, fontSize: 12, resize: "vertical",
            outline: "none", boxSizing: "border-box", lineHeight: 1.6,
          }}
        />
        <div style={{ marginTop: 12, display: "flex", gap: 10, alignItems: "center" }}>
          <Btn onClick={analyze} style={{ opacity: loading ? 0.7 : 1 }}>
            {loading ? "Analyzing..." : "Analyze Solicitation →"}
          </Btn>
          <span style={{ fontSize: 11, color: C.textDim, fontFamily: font.mono }}>Powered by Claude AI</span>
        </div>
        {error && <div style={{ marginTop: 10, fontSize: 12, color: C.danger }}>{error}</div>}
      </Card>

      {loading && (
        <Card style={{ textAlign: "center", padding: 40 }}>
          <div style={{ fontSize: 32, marginBottom: 12 }}>🤖</div>
          <div style={{ fontFamily: font.mono, color: C.green, letterSpacing: 1 }}>Reading solicitation...</div>
          <div style={{ fontSize: 12, color: C.textMid, marginTop: 8 }}>Extracting scope, requirements, and evaluation criteria</div>
        </Card>
      )}

      {result && (
        <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
          {/* HEADER */}
          <Card glow={result.recommendation === "BID"}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", gap: 16 }}>
              <div style={{ flex: 1 }}>
                <div style={{ fontSize: 16, fontWeight: 700, marginBottom: 6 }}>{result.title}</div>
                <div style={{ display: "flex", gap: 16, flexWrap: "wrap" }}>
                  <span style={{ fontSize: 12, color: C.textMid }}>🏛 {result.agency}</span>
                  {result.deadline && <span style={{ fontSize: 12, color: C.textMid }}>📅 {result.deadline}</span>}
                  {result.value && <span style={{ fontSize: 12, color: C.textMid }}>💰 {result.value}</span>}
                  {result.naics && <span style={{ fontSize: 12, color: C.textMid }}>📁 NAICS {result.naics}</span>}
                  {result.setAside && <Pill color={C.green}>{result.setAside}</Pill>}
                </div>
              </div>
              <div style={{ textAlign: "center" }}>
                <div style={{ fontSize: 36, fontWeight: 900, fontFamily: font.mono, color: result.fitScore >= 80 ? C.green : result.fitScore >= 60 ? C.warning : C.danger }}>{result.fitScore}%</div>
                <div style={{ fontSize: 9, color: C.textDim, letterSpacing: 1, textTransform: "uppercase" }}>Fit Score</div>
              </div>
            </div>
          </Card>

          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 14 }}>
            {/* SCOPE */}
            <Card>
              <div style={{ fontFamily: font.mono, fontSize: 10, color: C.green, letterSpacing: 1.5, textTransform: "uppercase", marginBottom: 10 }}>Scope Summary</div>
              <div style={{ fontSize: 13, color: C.textMid, lineHeight: 1.7 }}>{result.scope}</div>
            </Card>

            {/* RECOMMENDATION */}
            <Card style={{ borderColor: (result.recommendation === "BID" ? C.green : C.danger) + "40" }}>
              <div style={{ fontFamily: font.mono, fontSize: 10, color: C.textMid, letterSpacing: 1.5, textTransform: "uppercase", marginBottom: 10 }}>AI Recommendation</div>
              <div style={{ fontSize: 28, fontFamily: font.display, letterSpacing: 2, color: result.recommendation === "BID" ? C.green : C.danger, marginBottom: 8 }}>{result.recommendation}</div>
              <div style={{ fontSize: 13, color: C.textMid, lineHeight: 1.6 }}>{result.recommendationReason}</div>
            </Card>
          </div>

          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 14 }}>
            {/* REQUIREMENTS */}
            <Card>
              <div style={{ fontFamily: font.mono, fontSize: 10, color: C.blue, letterSpacing: 1.5, textTransform: "uppercase", marginBottom: 10 }}>Key Requirements</div>
              {result.requirements?.map((r, i) => (
                <div key={i} style={{ display: "flex", gap: 8, marginBottom: 8 }}>
                  <span style={{ color: C.blue }}>›</span>
                  <span style={{ fontSize: 12, color: C.textMid, lineHeight: 1.5 }}>{r}</span>
                </div>
              ))}
            </Card>

            {/* EVALUATION */}
            <Card>
              <div style={{ fontFamily: font.mono, fontSize: 10, color: C.warning, letterSpacing: 1.5, textTransform: "uppercase", marginBottom: 10 }}>Evaluation Criteria</div>
              {result.evaluation?.map((r, i) => (
                <div key={i} style={{ display: "flex", gap: 8, marginBottom: 8 }}>
                  <span style={{ color: C.warning }}>›</span>
                  <span style={{ fontSize: 12, color: C.textMid, lineHeight: 1.5 }}>{r}</span>
                </div>
              ))}
            </Card>

            {/* RED FLAGS */}
            <Card style={{ borderColor: result.redFlags?.length ? C.danger + "30" : C.border }}>
              <div style={{ fontFamily: font.mono, fontSize: 10, color: C.danger, letterSpacing: 1.5, textTransform: "uppercase", marginBottom: 10 }}>Red Flags</div>
              {result.redFlags?.length ? result.redFlags.map((r, i) => (
                <div key={i} style={{ display: "flex", gap: 8, marginBottom: 8 }}>
                  <span style={{ color: C.danger }}>⚠</span>
                  <span style={{ fontSize: 12, color: C.textMid, lineHeight: 1.5 }}>{r}</span>
                </div>
              )) : <div style={{ fontSize: 12, color: C.green }}>✓ No major red flags detected</div>}
            </Card>
          </div>
        </div>
      )}
    </div>
  );
}

